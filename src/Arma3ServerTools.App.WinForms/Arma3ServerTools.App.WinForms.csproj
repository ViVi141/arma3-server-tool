<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Arma3ServerTools.App.WinForms</RootNamespace>
    <AssemblyName>Arma3ServerTools</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\1_arma3server_x64.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationTitle>Arma3 Server Tools</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationPublisher>$(Company)</ApplicationPublisher>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arma3ServerTools.Application\Arma3ServerTools.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\sql\a3st_statistics.sql" Link="sql\a3st_statistics.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\sql\a3st_players.sql" Link="sql\a3st_players.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\docs\first-server-guide.md" Link="docs\first-server-guide.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\docs\first-server-guide.txt" Link="docs\first-server-guide.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\docs\release-README.txt" Link="README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\NOTICE" Link="NOTICE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\1_arma3server_x64.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\reward-wechat.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\reward-alipay.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.3.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.58" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\mod\%40a3st_monitor\**\*.*">
      <Link>mod\%40a3st_monitor\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildMonitoringHost" BeforeTargets="CopyMonitoringHost" Condition="'$(RuntimeIdentifier)' == ''">
    <MSBuild Projects="..\Arma3ServerTools.MonitoringHost\Arma3ServerTools.MonitoringHost.csproj" Properties="Configuration=$(Configuration)" Targets="Build" />
  </Target>

  <Target Name="BuildAgentHost" BeforeTargets="CopyAgentHost" Condition="'$(RuntimeIdentifier)' == ''">
    <MSBuild Projects="..\Arma3ServerTools.Agent.Host\Arma3ServerTools.Agent.Host.csproj" Properties="Configuration=$(Configuration)" Targets="Build" />
  </Target>

  <Target Name="CopyMonitoringHost" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <MonitoringHostOutDir>$(MSBuildProjectDirectory)\..\Arma3ServerTools.MonitoringHost\bin\$(Configuration)\net10.0-windows\</MonitoringHostOutDir>
      <MonitoringHostDeployDir>$(OutputPath)monitoring\</MonitoringHostDeployDir>
      <MonitoringHostExeName>Arma3ServerTools.MonitoringHost.exe</MonitoringHostExeName>
    </PropertyGroup>
    <ItemGroup>
      <MonitoringHostFiles Include="$(MonitoringHostOutDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(MonitoringHostDeployDir)" Condition="Exists('$(MonitoringHostOutDir)$(MonitoringHostExeName)')" />
    <Copy SourceFiles="@(MonitoringHostFiles)" DestinationFolder="$(MonitoringHostDeployDir)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(MonitoringHostOutDir)$(MonitoringHostExeName)')" />
  </Target>

  <Target Name="CopyAgentHost" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <AgentHostOutDir>$(MSBuildProjectDirectory)\..\Arma3ServerTools.Agent.Host\bin\$(Configuration)\net10.0-windows\</AgentHostOutDir>
      <AgentHostDeployDir>$(OutputPath)agent\</AgentHostDeployDir>
      <AgentHostExeName>Arma3ServerTools.Agent.Host.exe</AgentHostExeName>
    </PropertyGroup>
    <ItemGroup>
      <AgentHostFiles Include="$(AgentHostOutDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(AgentHostDeployDir)" Condition="Exists('$(AgentHostOutDir)$(AgentHostExeName)')" />
    <Copy SourceFiles="@(AgentHostFiles)" DestinationFolder="$(AgentHostDeployDir)%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(AgentHostOutDir)$(AgentHostExeName)')" />
  </Target>

  <Target Name="CopyMonitoringServerDll" AfterTargets="Build">
    <PropertyGroup>
      <MonitoringDllSource>$(MSBuildProjectDirectory)\..\..\DestinyServerMonitoring\DestinyServerMonitoring\bin\x64\Release\DestinyServerMonitoring.dll</MonitoringDllSource>
      <MonitoringDllDeployDir>$(OutputPath)monitoring-server\</MonitoringDllDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(MonitoringDllDeployDir)" Condition="Exists('$(MonitoringDllSource)')" />
    <Copy SourceFiles="$(MonitoringDllSource)" DestinationFolder="$(MonitoringDllDeployDir)" SkipUnchangedFiles="true" Condition="Exists('$(MonitoringDllSource)')" />
  </Target>

</Project>
