<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Arma3ServerTools.App.WinForms</RootNamespace>
    <AssemblyName>Arma3ServerTools</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Assets\1_arma3server_x64.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arma3ServerTools.Application\Arma3ServerTools.Application.csproj" />
    <ProjectReference Include="..\Arma3ServerTools.Core\Arma3ServerTools.Core.csproj" />
    <ProjectReference Include="..\Arma3ServerTools.MonitoringHost\Arma3ServerTools.MonitoringHost.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\sql\destiny_statistics.sql" Link="sql\destiny_statistics.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\sql\destiny_players.sql" Link="sql\destiny_players.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyMonitoringHost" AfterTargets="Build">
    <PropertyGroup>
      <MonitoringHostOutDir>$(MSBuildProjectDirectory)\..\Arma3ServerTools.MonitoringHost\bin\$(Configuration)\net48\</MonitoringHostOutDir>
      <MonitoringHostDeployDir>$(OutputPath)monitoring\</MonitoringHostDeployDir>
      <MonitoringHostExeName>Arma3ServerTools.MonitoringHost.exe</MonitoringHostExeName>
    </PropertyGroup>
    <ItemGroup>
      <MonitoringHostFiles Include="$(MonitoringHostOutDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(MonitoringHostDeployDir)" Condition="Exists('$(MonitoringHostOutDir)$(MonitoringHostExeName)')" />
    <Copy
      SourceFiles="@(MonitoringHostFiles)"
      DestinationFolder="$(MonitoringHostDeployDir)%(RecursiveDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(MonitoringHostOutDir)$(MonitoringHostExeName)')" />
  </Target>
  <Target Name="BuildSteamCmdToolsIfNeeded" BeforeTargets="CopySteamCmdTools">
    <PropertyGroup>
      <SteamCmdToolsProject>$(MSBuildProjectDirectory)\..\..\Steamcmdtools\steamcmd\steamcmdTools.csproj</SteamCmdToolsProject>
      <SteamCmdToolsBuildDir>$(MSBuildProjectDirectory)\..\..\Steamcmdtools\steamcmd\bin\$(Configuration)\net6.0-windows10.0.20348.0\</SteamCmdToolsBuildDir>
    </PropertyGroup>
    <MSBuild
      Projects="$(SteamCmdToolsProject)"
      Properties="Configuration=$(Configuration)"
      Condition="Exists('$(SteamCmdToolsProject)') And !Exists('$(SteamCmdToolsBuildDir)steamcmdTools.exe')" />
  </Target>
  <Target Name="CopySteamCmdTools" AfterTargets="Build">
    <PropertyGroup>
      <SteamCmdToolsOutDir>$(MSBuildProjectDirectory)\..\..\Steamcmdtools\steamcmd\bin\$(Configuration)\net6.0-windows10.0.20348.0\</SteamCmdToolsOutDir>
      <SteamCmdToolsDeployDir>$(OutputPath)steamcmdTools\</SteamCmdToolsDeployDir>
      <SteamCmdToolsExeName>steamcmdTools.exe</SteamCmdToolsExeName>
    </PropertyGroup>
    <ItemGroup>
      <SteamCmdToolsFiles Include="$(SteamCmdToolsOutDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(SteamCmdToolsDeployDir)" Condition="Exists('$(SteamCmdToolsOutDir)$(SteamCmdToolsExeName)')" />
    <Copy
      SourceFiles="@(SteamCmdToolsFiles)"
      DestinationFolder="$(SteamCmdToolsDeployDir)%(RecursiveDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(SteamCmdToolsOutDir)$(SteamCmdToolsExeName)')" />
  </Target>

</Project>
